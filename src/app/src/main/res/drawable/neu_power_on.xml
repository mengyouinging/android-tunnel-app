<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval"><solid android:color="#18FFFFFF"/></shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#B6C9CA" android:endColor="#EDF5F4"/>
            <stroke android:width="1dp" android:color="#CCD9DD"/>
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#DFECEA"/>
            <stroke android:width="2dp" android:color="#7EAAA5"/>
        </shape>
    </item>
</layer-list>
