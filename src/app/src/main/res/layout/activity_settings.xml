<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/NeuPage">
    <LinearLayout style="@style/NeuContent" android:focusableInTouchMode="true">
        <TextView style="@style/NeuTitle" android:text="@string/open_settings"/>
        <LinearLayout style="@style/NeuCard">
            <TextView style="@style/NeuLabel" android:text="@string/field_domain" android:labelFor="@id/domain"/>
            <EditText android:id="@+id/domain" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_token" android:labelFor="@id/token"/>
            <EditText android:id="@+id/token" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_port" android:labelFor="@id/port"/>
            <EditText android:id="@+id/port" style="@style/NeuInput" android:inputType="number"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_relay" android:labelFor="@id/relay"/>
            <EditText android:id="@+id/relay" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_edge" android:labelFor="@id/edge"/>
            <EditText android:id="@+id/edge" style="@style/NeuInput" android:inputType="text"/>
        </LinearLayout>
        <LinearLayout style="@style/NeuCard">
            <TextView style="@style/NeuLabel" android:text="@string/field_awg_private" android:labelFor="@id/awg_private"/>
            <EditText android:id="@+id/awg_private" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_peer_public" android:labelFor="@id/peer_public"/>
            <EditText android:id="@+id/peer_public" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_peer_endpoint" android:labelFor="@id/peer_endpoint"/>
            <EditText android:id="@+id/peer_endpoint" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_allowed_ips" android:labelFor="@id/allowed_ips"/>
            <EditText android:id="@+id/allowed_ips" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_interface_address" android:labelFor="@id/interface_address"/>
            <EditText android:id="@+id/interface_address" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_jitter" android:labelFor="@id/jitter"/>
            <EditText android:id="@+id/jitter" style="@style/NeuInput" android:inputType="text"/>
        </LinearLayout>
        <LinearLayout style="@style/NeuCard">
            <TextView style="@style/NeuLabel" android:text="@string/field_uuid" android:labelFor="@id/uuid"/>
            <EditText android:id="@+id/uuid" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_reality_private" android:labelFor="@id/reality_private"/>
            <EditText android:id="@+id/reality_private" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_reality_id" android:labelFor="@id/reality_id"/>
            <EditText android:id="@+id/reality_id" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_reality_name" android:labelFor="@id/reality_name"/>
            <EditText android:id="@+id/reality_name" style="@style/NeuInput" android:inputType="text"/>
        </LinearLayout>
        <LinearLayout style="@style/NeuCard">
            <TextView style="@style/NeuLabel" android:text="@string/field_hysteria_password" android:labelFor="@id/hysteria_password"/>
            <EditText android:id="@+id/hysteria_password" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_hysteria_cert" android:labelFor="@id/hysteria_cert"/>
            <EditText android:id="@+id/hysteria_cert" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_hysteria_key" android:labelFor="@id/hysteria_key"/>
            <EditText android:id="@+id/hysteria_key" style="@style/NeuInput" android:inputType="textPassword"/>
        </LinearLayout>
        <LinearLayout style="@style/NeuCard">
            <TextView style="@style/NeuLabel" android:text="@string/field_easy_tier_network" android:labelFor="@id/easy_tier_network"/>
            <EditText android:id="@+id/easy_tier_network" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_easy_tier_secret" android:labelFor="@id/easy_tier_secret"/>
            <EditText android:id="@+id/easy_tier_secret" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_probe_host" android:labelFor="@id/probe_host"/>
            <EditText android:id="@+id/probe_host" style="@style/NeuInput" android:inputType="text"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_probe_port" android:labelFor="@id/probe_port"/>
            <EditText android:id="@+id/probe_port" style="@style/NeuInput" android:inputType="number"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_cf_tunnel_token" android:labelFor="@id/cf_tunnel_token"/>
            <EditText android:id="@+id/cf_tunnel_token" style="@style/NeuInput" android:inputType="textPassword"/>
            <TextView style="@style/NeuLabel" android:text="@string/field_ws_remote" android:labelFor="@id/ws_remote"/>
            <EditText android:id="@+id/ws_remote" style="@style/NeuInput" android:inputType="text"/>
        </LinearLayout>
        <LinearLayout style="@style/NeuCard">
            <CheckBox android:id="@+id/auto_start" style="@style/NeuCheckBox" android:text="@string/autostart"/>
        </LinearLayout>
        <Button android:id="@+id/test_token" style="@style/NeuButton" android:text="@string/test_token"/>
        <Button android:id="@+id/save_config" style="@style/NeuButton" android:text="@string/save_config"/>
        <TextView android:id="@+id/result" style="@style/NeuBody" android:padding="16dp" android:minHeight="48dp"/>
        <TextView style="@style/NeuBody" android:text="@string/settings_note" android:textColor="@color/neu_secondary" android:textSize="13sp" android:background="@drawable/neu_raised" android:padding="24dp"/>
    </LinearLayout>
</ScrollView>
